# 이 파일을 복사해 .env.local 로 만들고 값을 채우면 로컬에서 테스트할 수 있어요.
# Vercel에서는 [Settings] > [Environment Variables]에 같은 이름으로 넣어 주세요.

# 메일플러그 SMTP
MAIL_HOST=smtp.mailplug.co.kr
MAIL_PORT=465
MAIL_USER=보내는메일주소@회사도메인
MAIL_PASS=메일비밀번호
MAIL_FROM_NAME=ICH 교육 담당자

# Google 시트 (apps-script/Code.gs 배포 후 받은 웹 앱 URL)
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
SHEET_WEBHOOK_SECRET=시트-스크립트-속성-SECRET과-같은-값

# Vercel Blob (Vercel에서 Blob 저장소를 연결하면 자동으로 들어가요. 로컬 테스트 때만 직접 넣기)
BLOB_READ_WRITE_TOKEN=
